# ─────────────────────────────────────────────────────────────
# Dotfiles .gitignore
# Focused on what a stow-managed dotfiles repo actually needs.
# NOTE: intentionally NOT ignoring lib/ build/ dist/ var/ etc. —
# those broad Python-template rules can silently hide real config.
# ─────────────────────────────────────────────────────────────

# ── Secrets (never commit) ──
secrets.zsh
*.secret
*.secrets
.env
.env.*
*.key
*.pem
id_rsa
id_ed25519
*_token
*_credentials

# ── Machine-local overrides ──
# Convention: source a *.local file if present, keep it out of git.
*.local
*.local.zsh
*.local.sh
*.local.toml

# ── Python bytecode (ranger / qtile configs) ──
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Editor / tooling junk ──
*.swp
*.swo
*~
.DS_Store
tags
.direnv/

# ── Logs ──
*.log
