#!/usr/bin/env bash

export SCRIPTPATH="$( cd "$(dirname "$0")" ; pwd -P )"

# unload the old theme
if [ -f "/tmp/leftwm-theme-down" ]; then
	/tmp/leftwm-theme-down
	rm /tmp/leftwm-theme-down
fi

echo "Load downscript"
# load the down script to the expected location
ln -s $SCRIPTPATH/down /tmp/leftwm-theme-down

#boot picom or compton if it exists
#if [ -x "$(command -v picom)" ]; then
#  #picom --config $SCRIPTPATH/picom.conf &> /dev/null &
#  #picom --config $HOME/.config/leftwm/themes/current/picom.conf &> /dev/null &
#elif [ -x "$(command -v compton)" ]; then
#  #compton &> /dev/null &
#fi

/usr/lib/mate-polkit/polkit-mate-authentication-agent-1 &

case $HOSTNAME in
  jugoplastika) 
	  # Any specific laptop thing?
	  ;;
  bessie) 
	  # Any specific desktop thing?
	  # Streamdeck UI
	  streamdeck -n &> /dev/null &
	  ;;
  *)   
	  echo "How did I get in the middle of nowhere?";;
esac

# set the theme.ron config
leftwm-command "LoadTheme $SCRIPTPATH/theme.ron"

# set background using .fehbg file if it exists
if [ -x "$(command -v feh)" ] && [ -f "$HOME/.fehbg" ]; then
  $HOME/.fehbg
fi

# Autorandr
autorandr --change

sleep 1

# Load the pinned Oatbar 0.3.1 build as the primary bar. Keep the system package as fallback.
OATBAR_031_BIN="$HOME/.local/opt/oatbar/0.3.1/bin"
if [ -x "$OATBAR_031_BIN/oatbar" ]; then
  PATH="$OATBAR_031_BIN:$PATH" "$OATBAR_031_BIN/oatbar" &
else
  oatbar &
fi

# Caps To Ctrl & Esc
setxkbmap -option ctrl:nocaps
xcape -e 'Control_L=Escape' -t 175

# Udiskie
udiskie &
